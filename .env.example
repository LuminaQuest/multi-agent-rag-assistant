# ==============================================================================
# NexusCore Multi-Agent RAG Assistant — Environment Configuration
# Note: Zero-Friction Setup — If no API keys are provided, the system runs
# on its built-in local cognitive engine with 100% functionality.
# ==============================================================================

# Google Gemini (Free Tier supported: https://aistudio.google.com)
GEMINI_API_KEY=

# Groq Cloud (Free Ultra-Fast Llama-3: https://console.groq.com)
GROQ_API_KEY=

# OpenAI (Optional)
OPENAI_API_KEY=

# Local Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Environment
ENVIRONMENT=development
